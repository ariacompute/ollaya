  "inputs": [
    "input_ids",
    "attention_mask",
    "marker_pos",
    "marker_mask",
    "qtype"
  ],
  "outputs": [
    "logits",
    "act_logits"
  ],
  "min_markers": 2,
  "hubs": {
    "huggingface": "ariacompute/afm-de",
    "modelscope": "AriaCompute/afm-de"
  },
  "opset": 23
