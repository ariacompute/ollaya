  "engine": "onnx",
  "family": "afm-de",
  "layout": "afm-de-latest",
  "encoder": "answerdotai/ModernBERT-large",
  "max_len": 1024,
  "head_max_len": 512,
  "option_desc_max": 96,
  "state_truncation": "tail",
  "shortlist": {
    "threshold": 40,
    "k": 20
  },
